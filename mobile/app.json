{
  "expo": {
    "name": "DreamJob",
    "slug": "dreamjob",
    "scheme": "dreamjob",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#1F4FD8" },
    "ios": { "bundleIdentifier": "app.dreamjob.mobile", "supportsTablet": false, "infoPlist": { "ITSAppUsesNonExemptEncryption": false } },
    "android": { "package": "app.dreamjob.mobile", "adaptiveIcon": { "backgroundColor": "#1F4FD8", "foregroundImage": "./assets/android-icon-foreground.png" } },
    "plugins": ["expo-secure-store"]
  }
}
